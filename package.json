{
  "name": "tbwllm",
  "version": "0.1.0",
  "description": "Trading Bot with LLM - Algorithmic trading system with TypeScript + Python",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "start": "tsx src/index.ts",
    "ingest": "tsx src/ingestion/cli.ts",
    "ingest:dry": "tsx src/ingestion/cli.ts --dry-run",
    "ingest:static": "tsx src/ingestion/cli.ts --no-llm",
    "reanalyze": "tsx src/ingestion/reanalyze.ts",
    "assemble": "tsx src/assembly/cli.ts",
    "data:fetch": "tsx src/data/cli.ts",
    "backtest": "tsx src/backtest/run.ts",
    "sweep": "tsx src/backtest/sweep.ts",
    "bot:paper": "tsx src/bot/paper-trader.ts",
    "bot:webhook": "tsx src/bot/webhook-server.ts"
  },
  "keywords": [
    "trading",
    "algorithmic-trading",
    "bot",
    "cryptocurrency",
    "backtesting",
    "technical-analysis"
  ],
  "author": "LyonSsS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LyonSsS/tbwllm.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.85.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.8.0",
    "ccxt": "^4.2.25",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "playwright": "^1.63.0",
    "trading-signals": "^8.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
