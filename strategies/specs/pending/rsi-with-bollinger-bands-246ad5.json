  "version": "1",
  "strategyType": "condition",
  "assetClass": "any",
  "bindings": {
    "rsiValue": {
      "type": "RSI",
      "params": {
        "period": "rsiLength"
      }
    },
    "basis": {
      "type": "SMA",
      "source": "rsiValue",
      "params": {
        "period": "bbLength"
      }
    },
    "dev": {
      "type": "STDDEV",
      "source": "rsiValue",
      "params": {
        "period": "bbLength"
      }
    }
  },
  "entry": {
    "direction": "BOTH",
    "conditions": [
      "rsiValue > basis + dev * bbUp",
      "rsiValue < basis - dev * bbDown"
    ]
  },
  "parameters": {
    "rsiLength": 14,
    "bbLength": 20,
    "bbUp": 2,
    "bbDown": 2
  },
  "parsedBy": "manual",
